rules_version = '2';

// Règles Firestore de la collection Géo Europe.
// Les commandes et les droits sont écrits uniquement par le serveur (Firebase Admin ignore ces règles).
// Le navigateur peut seulement lire ce qui appartient au joueur connecté. Tout le reste est refusé.
service cloud.firestore {
  match /databases/{database}/documents {
    match /entitlements/{app}/users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /orders/{orderId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // Accès offerts (liste privée par application) et administrateurs : serveur uniquement,
    // ni lecture ni écriture depuis le navigateur, même pour un bénéficiaire ou un administrateur.
    // Écrits par src/services/grants.ts et scripts/admin.mjs, voir docs/acces-offerts.md.
    match /grants/{app}/emails/{email} {
      allow read, write: if false;
    }

    match /admins/{uid} {
      allow read, write: if false;
    }

    // Demandes de rétractation : serveur uniquement, même pour celui qui l'a envoyée (voir docs/retractation.md).
    match /withdrawals/{app}/requests/{id} {
      allow read, write: if false;
    }

    // Jetons d'achat Google Play (preuve d'achat) : serveur uniquement. Les commandes n'en gardent que l'empreinte.
    match /playPurchases/{tokenHash} {
      allow read, write: if false;
    }

    // Tout le reste, dont mailThrottle (limite d'envoi des courriels), n'est utilisé que par le serveur.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
