{
  "name": "geofr",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:export": "node scripts/build-export.mjs",
    "android:sync": "npx cap sync android && node scripts/android-media.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check:emoji": "node scripts/check-no-emoji.mjs",
    "check:content": "node scripts/check-content.mjs",
    "check:engine": "node scripts/check-engine.mjs",
    "check:family": "node scripts/check-family.mjs",
    "check:legal": "node scripts/check-legal.mjs",
    "check": "npm run lint && npm run typecheck && npm run check:emoji && npm run check:content && npm run check:engine && npm run check:family && npm run check:legal && npm run check:payments && npm run check:grants && npm run check:withdrawal && npm run check:promotions && npm run check:ads",
    "check:payments": "node scripts/check-payments.mjs",
    "check:grants": "node scripts/check-grants.mjs",
    "check:withdrawal": "node scripts/check-withdrawal.mjs",
    "check:promotions": "node scripts/check-promotions.mjs",
    "check:ads": "node scripts/check-ads.mjs",
    "test:payments": "npx --yes firebase-tools@15 emulators:exec --project demo-geofr --only auth,firestore \"node scripts/test-payments-emulator.mjs\""
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.3.0",
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@mollie/api-client": "^4.6.0",
    "firebase": "^13.2.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^1.66.0",
    "next": "16.4.4",
    "nodemailer": "^10.1.7",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^24",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "type": "module",
  "overrides": {
    "jwks-rsa": "3.2.2"
  }
}
