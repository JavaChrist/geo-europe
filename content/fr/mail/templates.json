    "confirmation": {
      "subject": "Confirmez votre adresse email — GéoFR",
      "html": "<!DOCTYPE html>\n<html lang=\"fr\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Confirmez votre adresse email — GéoFR</title>\n</head>\n<body style=\"margin:0;padding:0;background:#f4f4f5;\">\n  <!-- Sujet : Confirmez votre adresse email — GéoFR -->\n  <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#f4f4f5;\">\n    <tr>\n      <td align=\"center\" style=\"padding:24px 12px;\">\n        <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:600px;background:#ffffff;border:1px solid #e4e4e7;\">\n          <tr>\n            <td style=\"padding:28px 24px 8px;\">\n              <img src=\"https://geofr.appsgeo.com/logo180.png\" width=\"72\" height=\"72\" alt=\"Logo GéoFR\" style=\"display:block;border:0;outline:none;text-decoration:none;width:72px;height:72px;\">\n              <p style=\"margin:16px 0 0;font-size:18px;line-height:24px;font-weight:700;color:#18181b;\">GéoFR</p>\n              <p style=\"margin:4px 0 0;font-size:13px;line-height:18px;color:#71717a;\">by JavaChrist</p>\n            </td>\n          </tr>\n          <tr>\n            <td style=\"padding:16px 24px 8px;\">\n              <h1 style=\"margin:0 0 16px;font-size:24px;line-height:32px;font-weight:700;color:#18181b;\">Confirmez votre adresse email</h1>\n              <p style=\"margin:0 0 12px;font-size:16px;line-height:24px;color:#18181b;\">Merci d’avoir créé votre compte.</p><p style=\"margin:0 0 12px;font-size:16px;line-height:24px;color:#18181b;\">Confirmez votre adresse email pour terminer votre inscription.</p>\n              <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin:8px 0 16px;\">\n            <tr>\n              <td bgcolor=\"#e0b44c\" style=\"border-radius:999px;\">\n                <a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;padding:14px 22px;font-size:16px;line-height:20px;font-weight:700;color:#18181b;text-decoration:none;\">Confirmer mon adresse</a>\n              </td>\n            </tr>\n          </table>\n              <p style=\"margin:0;font-size:14px;line-height:22px;color:#71717a;\">Si vous n’êtes pas à l’origine de cette inscription, vous pouvez ignorer cet email.</p>\n            </td>\n          </tr>\n          <tr>\n            <td style=\"padding:8px 24px 28px;\">\n              <p style=\"margin:16px 0 0;font-size:13px;line-height:20px;color:#71717a;\">JavaChrist — Applications &amp; automatisations</p>\n              <p style=\"margin:8px 0 0;font-size:13px;line-height:20px;color:#71717a;\">Support : support@appsgeo.com</p>\n            </td>\n          </tr>\n        </table>\n      </td>\n    </tr>\n  </table>\n</body>\n</html>\n"
    },
    "reset-password": {
      "subject": "Réinitialisez votre mot de passe — GéoFR",
      "html": "<!DOCTYPE html>\n<html lang=\"fr\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Réinitialisez votre mot de passe — GéoFR</title>\n</head>\n<body style=\"margin:0;padding:0;background:#f4f4f5;\">\n  <!-- Sujet : Réinitialisez votre mot de passe — GéoFR -->\n  <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#f4f4f5;\">\n    <tr>\n      <td align=\"center\" style=\"padding:24px 12px;\">\n        <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:600px;background:#ffffff;border:1px solid #e4e4e7;\">\n          <tr>\n            <td style=\"padding:28px 24px 8px;\">\n              <img src=\"https://geofr.appsgeo.com/logo180.png\" width=\"72\" height=\"72\" alt=\"Logo GéoFR\" style=\"display:block;border:0;outline:none;text-decoration:none;width:72px;height:72px;\">\n              <p style=\"margin:16px 0 0;font-size:18px;line-height:24px;font-weight:700;color:#18181b;\">GéoFR</p>\n              <p style=\"margin:4px 0 0;font-size:13px;line-height:18px;color:#71717a;\">by JavaChrist</p>\n            </td>\n          </tr>\n          <tr>\n            <td style=\"padding:16px 24px 8px;\">\n              <h1 style=\"margin:0 0 16px;font-size:24px;line-height:32px;font-weight:700;color:#18181b;\">Réinitialisez votre mot de passe</h1>\n              <p style=\"margin:0 0 12px;font-size:16px;line-height:24px;color:#18181b;\">Nous avons reçu une demande de réinitialisation du mot de passe associé à votre compte.</p>\n              <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin:8px 0 16px;\">\n            <tr>\n              <td bgcolor=\"#e0b44c\" style=\"border-radius:999px;\">\n                <a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;padding:14px 22px;font-size:16px;line-height:20px;font-weight:700;color:#18181b;text-decoration:none;\">Réinitialiser mon mot de passe</a>\n              </td>\n            </tr>\n          </table>\n              <p style=\"margin:0;font-size:14px;line-height:22px;color:#71717a;\">Si vous n’avez pas demandé cette modification, vous pouvez ignorer cet email.</p>\n            </td>\n          </tr>\n          <tr>\n            <td style=\"padding:8px 24px 28px;\">\n              <p style=\"margin:16px 0 0;font-size:13px;line-height:20px;color:#71717a;\">JavaChrist — Applications &amp; automatisations</p>\n              <p style=\"margin:8px 0 0;font-size:13px;line-height:20px;color:#71717a;\">Support : support@appsgeo.com</p>\n            </td>\n          </tr>\n        </table>\n      </td>\n    </tr>\n  </table>\n</body>\n</html>\n"
    },
    "purchase-confirmation": {
      "subject": "Confirmation de votre achat — GéoFR",
      "html": "<!DOCTYPE html>\n<html lang=\"fr\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Confirmation de votre achat — GéoFR</title>\n</head>\n<body style=\"margin:0;padding:0;background:#f4f4f5;\">\n  <!-- Sujet : Confirmation de votre achat — GéoFR -->\n  <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#f4f4f5;\">\n    <tr>\n      <td align=\"center\" style=\"padding:24px 12px;\">\n        <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:600px;background:#ffffff;border:1px solid #e4e4e7;\">\n          <tr>\n            <td style=\"padding:28px 24px 8px;\">\n              <img src=\"https://geofr.appsgeo.com/logo180.png\" width=\"72\" height=\"72\" alt=\"Logo GéoFR\" style=\"display:block;border:0;outline:none;text-decoration:none;width:72px;height:72px;\">\n              <p style=\"margin:16px 0 0;font-size:18px;line-height:24px;font-weight:700;color:#18181b;\">GéoFR</p>\n              <p style=\"margin:4px 0 0;font-size:13px;line-height:18px;color:#71717a;\">by JavaChrist</p>\n            </td>\n          </tr>\n          <tr>\n            <td style=\"padding:16px 24px 8px;\">\n              <h1 style=\"margin:0 0 16px;font-size:24px;line-height:32px;font-weight:700;color:#18181b;\">Merci pour votre achat</h1>\n              <p style=\"margin:0 0 12px;font-size:16px;line-height:24px;color:#18181b;\">Votre paiement est confirmé et votre accès est ouvert.</p><p style=\"margin:0 0 12px;font-size:16px;line-height:24px;color:#18181b;\">Produit : {{ .ProductName }}</p><p style=\"margin:0 0 12px;font-size:16px;line-height:24px;color:#18181b;\">Prix payé : {{ .Amount }} TTC</p><p style=\"margin:0 0 12px;font-size:16px;line-height:24px;color:#18181b;\">Date : {{ .PurchaseDate }}</p><p style=\"margin:0 0 12px;font-size:16px;line-height:24px;color:#18181b;\">Numéro de commande : {{ .OrderId }}</p><p style=\"margin:0 0 12px;font-size:16px;line-height:24px;color:#18181b;\">Vous avez demandé l’accès immédiat à ce contenu numérique et reconnu perdre votre droit de rétractation dès l’ouverture de l’accès.</p><p style=\"margin:0 0 12px;font-size:16px;line-height:24px;color:#18181b;\">Conditions générales de vente acceptées : {{ .TermsURL }}</p>\n              <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin:8px 0 16px;\">\n            <tr>\n              <td bgcolor=\"#e0b44c\" style=\"border-radius:999px;\">\n                <a href=\"{{ .SiteURL }}\" style=\"display:inline-block;padding:14px 22px;font-size:16px;line-height:20px;font-weight:700;color:#18181b;text-decoration:none;\">Ouvrir GéoFR</a>\n              </td>\n            </tr>\n          </table>\n              <p style=\"margin:0;font-size:14px;line-height:22px;color:#71717a;\">Conservez cet email : il confirme votre achat. Pour toute question, répondez à cet email ou écrivez au support.</p>\n            </td>\n          </tr>\n          <tr>\n            <td style=\"padding:8px 24px 28px;\">\n              <p style=\"margin:16px 0 0;font-size:13px;line-height:20px;color:#71717a;\">JavaChrist — Applications &amp; automatisations</p>\n              <p style=\"margin:8px 0 0;font-size:13px;line-height:20px;color:#71717a;\">Support : support@appsgeo.com</p>\n            </td>\n          </tr>\n        </table>\n      </td>\n    </tr>\n  </table>\n</body>\n</html>\n"
    },
    "withdrawal-receipt": {
      "subject": "Accusé de réception de votre rétractation — GéoFR",
      "html": "<!DOCTYPE html>\n<html lang=\"fr\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Accusé de réception de votre rétractation — GéoFR</title>\n</head>\n<body style=\"margin:0;padding:0;background:#f4f4f5;\">\n  <!-- Sujet : Accusé de réception de votre rétractation — GéoFR -->\n  <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#f4f4f5;\">\n    <tr>\n      <td align=\"center\" style=\"padding:24px 12px;\">\n        <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:600px;background:#ffffff;border:1px solid #e4e4e7;\">\n          <tr>\n            <td style=\"padding:28px 24px 8px;\">\n              <img src=\"https://geofr.appsgeo.com/logo180.png\" width=\"72\" height=\"72\" alt=\"Logo GéoFR\" style=\"display:block;border:0;outline:none;text-decoration:none;width:72px;height:72px;\">\n              <p style=\"margin:16px 0 0;font-size:18px;line-height:24px;font-weight:700;color:#18181b;\">GéoFR</p>\n              <p style=\"margin:4px 0 0;font-size:13px;line-height:18px;color:#71717a;\">by JavaChrist</p>\n            </td>\n          </tr>\n          <tr>\n            <td style=\"padding:16px 24px 8px;\">\n              <h1 style=\"margin:0 0 16px;font-size:24px;line-height:32px;font-weight:700;color:#18181b;\">Nous avons reçu votre demande de rétractation</h1>\n              <p style=\"margin:0 0 12px;font-size:16px;line-height:24px;color:#18181b;\">Cet email accuse réception de la déclaration de rétractation transmise depuis notre fonction de rétractation en ligne.</p><p style=\"margin:0 0 12px;font-size:16px;line-height:24px;color:#18181b;\">Reçue le : {{ .ReceivedAt }}</p><p style=\"margin:0 0 12px;font-size:16px;line-height:24px;color:#18181b;\">Référence de la demande : {{ .RequestId }}</p><p style=\"margin:0 0 12px;font-size:16px;line-height:24px;color:#18181b;\">Nom : {{ .CustomerName }}</p><p style=\"margin:0 0 12px;font-size:16px;line-height:24px;color:#18181b;\">Adresse email : {{ .CustomerEmail }}</p><p style=\"margin:0 0 12px;font-size:16px;line-height:24px;color:#18181b;\">Achat : {{ .PaymentMethod }}, commande {{ .OrderReference }}</p><p style=\"margin:0 0 12px;font-size:16px;line-height:24px;color:#18181b;\">Déclaration : « Je vous notifie ma rétractation du contrat portant sur la commande {{ .OrderReference }}. »</p><p style=\"margin:0 0 12px;font-size:16px;line-height:24px;color:#18181b;\">Message : {{ .Message }}</p><p style=\"margin:0 0 12px;font-size:16px;line-height:24px;color:#18181b;\">Votre demande va être examinée et nous vous répondrons par email. Le droit de rétractation peut ne pas s’appliquer à un contenu numérique fourni immédiatement avec votre accord exprès. Aucun remboursement ni retrait d’accès n’a lieu avant cet examen.</p>\n              <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin:8px 0 16px;\">\n            <tr>\n              <td bgcolor=\"#e0b44c\" style=\"border-radius:999px;\">\n                <a href=\"{{ .TermsURL }}\" style=\"display:inline-block;padding:14px 22px;font-size:16px;line-height:20px;font-weight:700;color:#18181b;text-decoration:none;\">Voir les conditions de vente</a>\n              </td>\n            </tr>\n          </table>\n              <p style=\"margin:0;font-size:14px;line-height:22px;color:#71717a;\">Conservez cet email : il indique la date et l’heure de réception de votre demande. Pour toute question, répondez à cet email.</p>\n            </td>\n          </tr>\n          <tr>\n            <td style=\"padding:8px 24px 28px;\">\n              <p style=\"margin:16px 0 0;font-size:13px;line-height:20px;color:#71717a;\">JavaChrist — Applications &amp; automatisations</p>\n              <p style=\"margin:8px 0 0;font-size:13px;line-height:20px;color:#71717a;\">Support : support@appsgeo.com</p>\n            </td>\n          </tr>\n        </table>\n      </td>\n    </tr>\n  </table>\n</body>\n</html>\n"
    }
  }
