# Noms des variables, sans valeur. Copier vers .env.local (jamais versionné) et remplir.
# Voir docs/paiements.md.

# Firebase, configuration publique du navigateur
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# 1 pour viser les émulateurs locaux
NEXT_PUBLIC_FIREBASE_EMULATORS=

# Firebase Admin, serveur uniquement. Secret
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Mollie, serveur uniquement. Clé de test (test_...) obligatoire. Secret
MOLLIE_API_KEY=

# Adresses du site
APP_BASE_URL=
PAYMENTS_WEBHOOK_BASE_URL=

# Protège /api/payments/reconcile, au moins 16 caractères. Secret
CRON_SECRET=

# Configuration SMTP — IONOS
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_REPLY_TO=
